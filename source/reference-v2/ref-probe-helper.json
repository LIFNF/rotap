{"source":"pragma solidity ^0.8.24;\ninterface IC {function TAPEOUT_FEE() external view returns(uint256);function tapeout(bytes calldata,uint32,uint32) external payable returns(uint256);function circuitInfo(uint256) external view returns(uint32,uint32,uint32,uint32);function step(uint256,bytes calldata,bytes calldata) external view returns(bytes memory,bytes memory);}\ncontract Probe {function onERC721Received(address,address,uint256,bytes calldata) external pure returns(bytes4){return 0x150b7a02;}function probe(address target,bytes calldata program,uint32 ni,uint32 no,bytes calldata state,bytes calldata input) external returns(uint32 nState,uint32 gates,bytes memory next,bytes memory output){IC c=IC(target);uint256 id=c.tapeout{value:c.TAPEOUT_FEE()}(program,ni,no);(,,nState,gates)=c.circuitInfo(id);(next,output)=c.step(id,state,input);}}\n","abi":[{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"bytes","name":"","type":"bytes"}],"name":"onERC721Received","outputs":[{"internalType":"bytes4","name":"","type":"bytes4"}],"stateMutability":"pure","type":"function"},{"inputs":[{"internalType":"address","name":"target","type":"address"},{"internalType":"bytes","name":"program","type":"bytes"},{"internalType":"uint32","name":"ni","type":"uint32"},{"internalType":"uint32","name":"no","type":"uint32"},{"internalType":"bytes","name":"state","type":"bytes"},{"internalType":"bytes","name":"input","type":"bytes"}],"name":"probe","outputs":[{"internalType":"uint32","name":"nState","type":"uint32"},{"internalType":"uint32","name":"gates","type":"uint32"},{"internalType":"bytes","name":"next","type":"bytes"},{"internalType":"bytes","name":"output","type":"bytes"}],"stateMutability":"nonpayable","type":"function"}],"runtime":""}