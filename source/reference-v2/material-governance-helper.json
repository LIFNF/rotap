{"source":"pragma solidity ^0.8.24;\ninterface IF {function deployFee() external view returns(uint256);function createCPU(string calldata,string calldata,string calldata,uint256,uint256) external payable returns(address,address);}\ncontract Other {function act(address t,bytes calldata data) external returns(bool,bytes memory){return t.call(data);}}\ncontract Probe {function onERC1155Received(address,address,uint256,uint256,bytes calldata) external pure returns(bytes4){return 0xf23a6e61;}function probe(address f,bytes[] calldata actions,bool outsider) external returns(bool[] memory ok,bytes[] memory result,bytes[] memory state){(address t,)=IF(f).createCPU{value:IF(f).deployFee()}(\"Processor\",\"CPU\",\"Story\",1000,123);Other other=new Other();ok=new bool[](actions.length);result=new bytes[](actions.length);for(uint256 i;i<actions.length;i++){if(outsider)(ok[i],result[i])=other.act(t,actions[i]);else {bytes4 selector;bytes memory act=actions[i];assembly{selector:=mload(add(act,32))}if(selector==bytes4(keccak256(\"mint(uint256,uint256)\"))){(,bytes memory b)=t.staticcall(abi.encodeWithSignature(\"protocolFee()\"));(ok[i],result[i])=t.call{value:abi.decode(b,(uint256))+123}(actions[i]);}else(ok[i],result[i])=t.call(actions[i]);}}state=new bytes[](7);string[5] memory getters=[\"supplyCap()\",\"mintPrice()\",\"protocolFee()\",\"walletCap()\",\"minted()\"];for(uint256 i;i<5;i++){(bool success,bytes memory r)=t.staticcall(abi.encodeWithSignature(getters[i]));state[i]=abi.encode(success,r);}for(uint256 i;i<2;i++){(bool success,bytes memory r)=t.staticcall(abi.encodeWithSignature(\"typeCap(uint256)\",i));state[5+i]=abi.encode(success,r);}}}","abi":[{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"bytes","name":"","type":"bytes"}],"name":"onERC1155Received","outputs":[{"internalType":"bytes4","name":"","type":"bytes4"}],"stateMutability":"pure","type":"function"},{"inputs":[{"internalType":"address","name":"f","type":"address"},{"internalType":"bytes[]","name":"actions","type":"bytes[]"},{"internalType":"bool","name":"outsider","type":"bool"}],"name":"probe","outputs":[{"internalType":"bool[]","name":"ok","type":"bool[]"},{"internalType":"bytes[]","name":"result","type":"bytes[]"},{"internalType":"bytes[]","name":"state","type":"bytes[]"}],"stateMutability":"nonpayable","type":"function"}],"runtime":""}